{
  "name": "korp",
  "displayName": "Korp",
  "description": "Sovereign AI coding assistant — Chat Participant @korp",
  "version": "0.0.1",
  "publisher": "korpforge",
  "license": "MIT",
  "icon": "resources/korp-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/korpforge/korp-vscode"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Chat"
  ],
  "activationEvents": [
    "onChatParticipant:korpforge.korp",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "korpforge.korp",
        "name": "korp",
        "fullName": "Korp",
        "description": "Sovereign AI coding assistant",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain the selected code or active file"
          },
          {
            "name": "fix",
            "description": "Fix errors in the selected code"
          },
          {
            "name": "test",
            "description": "Generate unit tests for the selected code"
          },
          {
            "name": "docs",
            "description": "Generate documentation for the selected code"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "korp",
          "title": "Korp",
          "icon": "resources/korp-icon.png"
        }
      ]
    },
    "views": {
      "korp": [
        {
          "id": "korp.skillsView",
          "name": "Skills",
          "type": "tree"
        }
      ]
    },
    "configuration": {
      "title": "Korp",
      "properties": {
        "korp.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:18789",
          "description": "Base URL of the OpenClaw gateway"
        },
        "korp.whisperUrl": {
          "type": "string",
          "default": "http://localhost:9500",
          "description": "URL of the Whisper STT sidecar"
        },
        "korp.ttsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable text-to-speech for @korp responses"
        },
        "korp.ttsModel": {
          "type": "string",
          "default": "~/.korpforge/models/piper/fr_FR-siwis-medium.onnx",
          "description": "Path to Piper ONNX voice model"
        },
        "korp.piperBin": {
          "type": "string",
          "default": "",
          "description": "Path to the piper binary (leave empty for auto-detection)"
        },
        "korp.recBin": {
          "type": "string",
          "default": "",
          "description": "Path to the rec (sox) binary for voice recording"
        },
        "korp.vadEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Voice Activity Detection (auto-listen when VS Code has focus)"
        },
        "korp.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log level for the Korp output channel"
        }
      }
    },
    "commands": [
      {
        "command": "korp.setGatewayToken",
        "title": "Korp: Set Gateway Token"
      },
      {
        "command": "korp.pushToTalk",
        "title": "Korp: Push to Talk"
      },
      {
        "command": "korp.stopSpeaking",
        "title": "Korp: Stop Speaking"
      },
      {
        "command": "korp.toggleTts",
        "title": "Korp: Toggle TTS (Text-to-Speech)"
      },
      {
        "command": "korp.toggleVad",
        "title": "Korp: Toggle VAD (Voice Activity Detection)"
      },
      {
        "command": "korp.toggleSkill",
        "title": "Korp: Toggle Skill"
      },
      {
        "command": "korp.refreshSkills",
        "title": "Korp: Refresh Skills",
        "icon": "$(refresh)"
      },
      {
        "command": "korp.openSkill",
        "title": "Korp: Open Skill File"
      },
      {
        "command": "korp.toggleLogLevel",
        "title": "Korp: Toggle Log Level (debug/info)"
      },
      {
        "command": "korp.runOnboarding",
        "title": "Korp: Run Onboarding Wizard"
      }
    ],
    "keybindings": [
      {
        "command": "korp.pushToTalk",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "korp.pushToTalk",
          "group": "Korp"
        },
        {
          "command": "korp.toggleSkill",
          "when": "false"
        },
        {
          "command": "korp.openSkill",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "korp.refreshSkills",
          "when": "view == korp.skillsView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.93.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6"
  }
}
