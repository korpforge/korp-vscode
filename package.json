{
  "name": "korp",
  "displayName": "Korp",
  "description": "Sovereign AI coding assistant — Chat Participant @korp",
  "version": "0.0.1",
  "publisher": "korpforge",
  "license": "MIT",
  "icon": "resources/korp-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/korpforge/korp-vscode"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": ["Chat"],
  "activationEvents": [
    "onChatParticipant:korpforge.korp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "korpforge.korp",
        "name": "korp",
        "fullName": "Korp",
        "description": "Sovereign AI coding assistant",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "Korp",
      "properties": {
        "korp.gatewayUrl": {
          "type": "string",
          "default": "ws://localhost:18789",
          "description": "URL WebSocket du gateway OpenClaw"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.0.0"
  }
}
